<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mohammad Saddam Studios | Cinema Lab & Visuals</title>
  <style>
    :root {
      --bg: #0a0a0c;
      --card-bg: #141419;
      --accent: #e50914;
      --gold: #d4af37;
      --text: #ffffff;
      --muted: #a0a0a8;
      --border: #26262e;
    }
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    body {
      background-color: var(--bg);
      color: var(--text);
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* VIP Gate Modal */
    #vipModal {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: radial-gradient(circle at center, rgba(25, 20, 25, 0.98), #050507);
      display: flex;
      justify-content: center;
      align-items: center;
      z-index: 9999;
      padding: 20px;
    }
    .vip-card {
      background: var(--card-bg);
      border: 1px solid var(--gold);
      border-radius: 16px;
      padding: 30px 24px;
      width: 100%;
      max-width: 430px;
      text-align: center;
      box-shadow: 0 10px 40px rgba(212, 175, 55, 0.2);
    }
    .vip-badge {
      display: inline-block;
      border: 1px solid var(--gold);
      color: var(--gold);
      font-size: 11px;
      letter-spacing: 2px;
      padding: 4px 12px;
      border-radius: 20px;
      text-transform: uppercase;
      margin-bottom: 12px;
    }
    .vip-card h2 {
      font-size: 22px;
      margin-bottom: 4px;
      color: #fff;
    }
    .vip-card .owner-sub {
      font-size: 13px;
      color: var(--gold);
      margin-bottom: 4px;
      font-weight: 600;
    }
    .vip-card .studio-loc {
      font-size: 12px;
      color: var(--muted);
      margin-bottom: 20px;
    }
    .form-group {
      margin-bottom: 15px;
      text-align: left;
    }
    .form-group label {
      display: block;
      font-size: 12px;
      color: var(--muted);
      margin-bottom: 6px;
      text-transform: uppercase;
    }
    .form-group input {
      width: 100%;
      padding: 12px 14px;
      background: #0d0d11;
      border: 1px solid var(--border);
      border-radius: 8px;
      color: #fff;
      font-size: 15px;
      outline: none;
    }
    .form-group input:focus {
      border-color: var(--gold);
    }
    .vip-btn {
      width: 100%;
      padding: 14px;
      background: linear-gradient(135deg, #d4af37, #aa820a);
      color: #000;
      font-size: 15px;
      font-weight: 700;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      margin-top: 10px;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    /* Main Website Content */
    #mainContent {
      display: none;
      padding-bottom: 80px;
    }
    header {
      padding: 40px 20px 25px;
      text-align: center;
      border-bottom: 1px solid var(--border);
      background: linear-gradient(180deg, #141419 0%, #0a0a0c 100%);
    }
    .brand-title {
      font-size: 26px;
      font-weight: 800;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      background: linear-gradient(90deg, #ffffff, #d4af37);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .brand-sub {
      font-size: 12px;
      color: var(--gold);
      letter-spacing: 2px;
      margin-top: 6px;
      text-transform: uppercase;
    }
    .owner-tag {
      font-size: 14px;
      color: #fff;
      margin-top: 8px;
    }
    .welcome-bar {
      margin-top: 15px;
      font-size: 14px;
      color: #70ff8b;
      background: rgba(112, 255, 139, 0.1);
      display: inline-block;
      padding: 6px 16px;
      border-radius: 20px;
      border: 1px solid rgba(112, 255, 139, 0.3);
    }

    /* Showcase Sections */
    .container {
      max-width: 1000px;
      margin: 0 auto;
      padding: 30px 20px;
    }
    .section-title {
      font-size: 20px;
      font-weight: 700;
      margin-bottom: 20px;
      border-left: 4px solid var(--accent);
      padding-left: 10px;
      color: #fff;
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 20px;
      margin-bottom: 40px;
    }
    .card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }
    .card-preview {
      width: 100%;
      height: 180px;
      background: #1b1b22;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--muted);
      font-size: 14px;
      border-bottom: 1px solid var(--border);
    }
    .card-info {
      padding: 18px;
      display: flex;
      flex-direction: column;
      flex-grow: 1;
    }
    .card-info h3 {
      font-size: 17px;
      margin-bottom: 6px;
      color: #fff;
    }
    .card-info p {
      font-size: 13px;
      color: var(--muted);
      margin-bottom: 14px;
      flex-grow: 1;
    }
    .order-action-btn {
      display: block;
      width: 100%;
      text-align: center;
      padding: 11px;
      background: #25d366;
      color: #fff;
      text-decoration: none;
      font-weight: 600;
      border-radius: 6px;
      font-size: 14px;
    }

    /* Studio Address Footer */
    .address-card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 24px;
      text-align: center;
      margin-top: 20px;
    }
    .address-card h3 {
      font-size: 18px;
      color: var(--gold);
      margin-bottom: 10px;
    }
    .address-card p {
      font-size: 14px;
      color: var(--muted);
      line-height: 1.6;
    }
    .address-card .phone-link {
      display: inline-block;
      margin-top: 12px;
      color: #fff;
      text-decoration: none;
      font-weight: 600;
    }

    /* Floating WhatsApp */
    .float-wa {
      position: fixed;
      bottom: 20px;
      right: 20px;
      background: #25d366;
      color: white;
      padding: 12px 20px;
      border-radius: 30px;
      font-weight: bold;
      text-decoration: none;
      box-shadow: 0 4px 15px rgba(37, 211, 102, 0.4);
      display: flex;
      align-items: center;
      gap: 8px;
      z-index: 100;
    }
  </style>
</head>
<body>

  <!-- VIP Gateway Modal -->
  <div id="vipModal">
    <div class="vip-card">
      <span class="vip-badge">VIP Access Only</span>
      <h2>Mohammad Saddam Studios</h2>
      <div class="owner-sub">Cinema Lab | Visuals | Media Works</div>
      <div class="studio-loc">📍 Dhanwar, Hazaribagh, Jharkhand - 825405</div>
      
      <form id="clientForm" onsubmit="handleVipAccess(event)">
        <div class="form-group">
          <label>Aapka Naam (Full Name)</label>
          <input type="text" id="clientName" placeholder="Jaise: Rahul Sharma" required>
        </div>
        <div class="form-group">
          <label>WhatsApp Number</label>
          <input type="tel" id="clientPhone" placeholder="Jaise: 9876543210" required>
        </div>
        <div class="form-group">
          <label>Email ID</label>
          <input type="email" id="clientEmail" placeholder="Jaise: name@gmail.com" required>
        </div>
        <button type="submit" class="vip-btn">Unlock VIP Access</button>
      </form>
    </div>
  </div>

  <!-- Portfolio Dashboard -->
  <div id="mainContent">
    <header>
      <div class="brand-title">Mohammad Saddam Studios</div>
      <div class="brand-sub">Cinema Lab • Visuals • Media Works • Motion Pictures</div>
      <div class="owner-tag">Founder & Lead Editor: <strong>Mohammad Saddam Hussain</strong></div>
      <div class="welcome-bar" id="welcomeMsg"></div>
    </header>

    <div class="container">
      <h2 class="section-title">Video Editing Services & Packages</h2>
      <div class="grid">
        
        <div class="card">
          <div class="card-preview">🎬 Viral Reels & Shorts</div>
          <div class="card-info">
            <h3>Instagram Reels & Shorts</h3>
            <p>High-retention editing, animated subtitles, trending hooks aur powerful sound effects.</p>
            <a href="https://wa.me/917781972099?text=Hi%20Saddam,%20mujhe%20Reels%20edit%20karwani%20hai" class="order-action-btn">Book Reel Edit</a>
          </div>
        </div>

        <div class="card">
          <div class="card-preview">📽️ 16:9 YouTube Cinematic</div>
          <div class="card-info">
            <h3>YouTube Long Form & Vlogs</h3>
            <p>Storytelling flow, cinematic color grading, B-roll integration aur background music mixing.</p>
            <a href="https://wa.me/917781972099?text=Hi%20Saddam,%20mujhe%20YouTube%20video%20edit%20karwani%20hai" class="order-action-btn">Book YouTube Edit</a>
          </div>
        </div>

        <div class="card">
          <div class="card-preview">💼 Commercial & Promo</div>
          <div class="card-info">
            <h3>Commercial & Brand Ads</h3>
            <p>High-conversion promo teasers, business ads aur modern visual effects.</p>
            <a href="https://wa.me/917781972099?text=Hi%20Saddam,%20mujhe%20Commercial%20Ad%20edit%20karwani%20hai" class="order-action-btn">Book Commercial Edit</a>
          </div>
        </div>

      </div>

      <!-- Studio Address Section -->
      <div class="address-card">
        <h3>📍 Official Studio Location</h3>
        <p><strong>Mohammad Saddam Studios</strong><br>
        Village: Dhanwar, District: Hazaribagh<br>
        Jharkhand, India - Pin Code: 825405</p>
        <a href="tel:7781972099" class="phone-link">📞 Call / Direct Contact: +91 7781972099</a>
      </div>
    </div>

    <a href="https://wa.me/917781972099" class="float-wa">WhatsApp Pe Baat Karein</a>
  </div>

  <script>
    function handleVipAccess(e) {
      e.preventDefault();
      const name = document.getElementById('clientName').value.trim();
      const phone = document.getElementById('clientPhone').value.trim();
      const email = document.getElementById('clientEmail').value.trim();

      if (!name || !phone || !email) return;

      // Unlock Screen
      document.getElementById('vipModal').style.display = 'none';
      document.getElementById('mainContent').style.display = 'block';
      document.getElementById('welcomeMsg').innerText = `Welcome to VIP Vault, ${name}!`;

      // Send client data to Saddam Hussain's WhatsApp
      const waMessage = `Naya VIP Client Unlocked!%0A- Client Naam: ${encodeURIComponent(name)}%0A- Phone: ${encodeURIComponent(phone)}%0A- Email: ${encodeURIComponent(email)}%0A- Studio: Mohammad Saddam Studios, Dhanwar`;
      const waUrl = `https://wa.me/917781972099?text=${waMessage}`;
      
      // Open WhatsApp
      window.open(waUrl, '_blank');
    }
  </script>
</body>
</html>
